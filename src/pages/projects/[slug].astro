---
import { getCollection } from 'astro:content';
import LegacyFallback from '../../components/LegacyFallback.astro';
import { contentKey } from '../../i18n.js';
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft && data.locale === 'zh');
  return projects.map((project) => ({ params: { slug: contentKey(project.id) }, props: { href: `/zh/projects/${contentKey(project.id)}/` } }));
}
const { href } = Astro.props;
---
<LegacyFallback {href} />

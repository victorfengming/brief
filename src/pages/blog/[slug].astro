---
import { getCollection } from 'astro:content';
import LegacyFallback from '../../components/LegacyFallback.astro';
import { contentKey } from '../../i18n.js';
export async function getStaticPaths() {
  const articles = await getCollection('blog', ({ data }) => !data.draft && data.locale === 'zh');
  return articles.map((article) => ({ params: { slug: contentKey(article.id) }, props: { href: `/zh/blog/${contentKey(article.id)}/` } }));
}
const { href } = Astro.props;
---
<LegacyFallback {href} />

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---
<BaseLayout title="技术文章" description="关于 MQTT、分布式系统与可靠性工程的技术笔记。">
  <div class="container page-hero"><p class="eyebrow">BLOG / FIELD NOTES</p><h1>技术文章<span class="gradient-text">.</span></h1><p class="lead">记录问题、实验步骤和工程取舍。未经审核的草稿不会进入文章列表或站点地图。</p></div>
  <section class="container section"><div class="cards">{articles.map((article) => <ArticleCard article={article} />)}</div>{articles.length === 0 && <p class="empty-state">暂无已发布文章。</p>}</section>
</BaseLayout>

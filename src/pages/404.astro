---
import BaseLayout from '../layouts/BaseLayout.astro';
import { path } from '../config/site';
---
<BaseLayout title="页面未找到" description="请求的页面不存在。"><div class="container page-hero not-found"><p class="eyebrow">ERROR / 404</p><h1>这里没有<br /><span class="gradient-text">你要找的页面。</span></h1><p class="lead">地址可能已更改，或者内容尚未发布。</p><a class="btn" href={path()}>返回首页 ↗</a></div></BaseLayout>
<style>.not-found{min-height:70vh}.not-found .btn{margin-top:25px}</style>

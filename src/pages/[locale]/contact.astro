---
import { LOCALES } from '../../i18n.js';
import { site, path } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params as { locale: 'zh' | 'en' };
const hasEmail = site.email.includes('@');
const text = locale === 'zh' ? { title: '保持联系', description: '联系与合作方式。', lead: '欢迎就自动驾驶云端系统、分布式通信与工程实践交流。正式发布前，请在配置中填入你的真实联系方式。', email: '邮件', github: '代码仓库', resume: '简历 PDF', send: '发送邮件', visit: '访问 GitHub', download: '下载 PDF', noEmail: '[YOUR_EMAIL] · 尚未配置', noGithub: '[YOUR_GITHUB_URL] · 尚未配置', noResume: '尚未上传 PDF；提供文件后再显示下载链接。' } : { title: 'Stay in touch', description: 'Ways to get in touch and collaborate.', lead: 'I welcome conversations about autonomous-driving cloud systems, distributed communication, and engineering practice. Add your real contact details to the configuration before publishing.', email: 'Email', github: 'Code repository', resume: 'Resume PDF', send: 'Send email', visit: 'Visit GitHub', download: 'Download PDF', noEmail: '[YOUR_EMAIL] · Not configured', noGithub: '[YOUR_GITHUB_URL] · Not configured', noResume: 'No PDF uploaded; a download link will appear when one is available.' };
---
<BaseLayout {locale} title={text.title} description={text.description} route="contact"><div class="container page-hero"><p class="eyebrow">CONTACT / CONNECT</p><h1>{text.title}<span class="gradient-text">.</span></h1><p class="lead">{text.lead}</p></div><section class="container section contact-grid"><div class="card"><div class="card-kicker">01 / EMAIL</div><h2>{text.email}</h2><p>{hasEmail ? site.email : text.noEmail}</p>{hasEmail && <a class="card-link" href={`mailto:${site.email}`}>{text.send} ↗</a>}</div><div class="card"><div class="card-kicker">02 / GITHUB</div><h2>{text.github}</h2><p>{site.github || text.noGithub}</p>{site.github && <a class="card-link" href={site.github} target="_blank" rel="noopener noreferrer">{text.visit} ↗</a>}</div><div class="card"><div class="card-kicker">03 / RESUME</div><h2>{text.resume}</h2><p>{site.resumePdf ? text.download : text.noResume}</p>{site.resumePdf && <a class="card-link" href={path(site.resumePdf)} download>{text.download} ↗</a>}</div></section></BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.card h2{font-size:27px}.card p{overflow-wrap:anywhere}@media(max-width:800px){.contact-grid{grid-template-columns:1fr}}</style>

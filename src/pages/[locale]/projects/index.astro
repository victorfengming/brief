---
import { getCollection } from 'astro:content';
import ProjectCard from '../../../components/ProjectCard.astro';
import { LOCALES } from '../../../i18n.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params as { locale: 'zh' | 'en' };
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.locale === locale)).sort((a, b) => a.data.order - b.data.order);
const text = locale === 'zh' ? { title: '工程项目', description: '自动驾驶云端系统与分布式工程项目案例。', lead: '每个案例按背景、职责、架构、挑战、方案、结果和复盘展开。标注为演示的内容仅用于说明写作结构。', empty: '暂无已审核的公开项目。' } : { title: 'Engineering projects', description: 'Case studies in autonomous-driving cloud systems and distributed engineering.', lead: 'Each case study covers background, responsibility, architecture, challenges, approach, results, and lessons. Demonstration content only illustrates a writing structure.', empty: 'No reviewed public projects yet.' };
---
<BaseLayout {locale} title={text.title} description={text.description} route="projects"><div class="container page-hero"><p class="eyebrow">PROJECTS / CASE STUDIES</p><h1>{text.title}<span class="gradient-text">.</span></h1><p class="lead">{text.lead}</p></div><section class="container section"><div class="cards">{projects.map((project) => <ProjectCard {project} {locale} />)}</div>{projects.length === 0 && <p class="empty-state">{text.empty}</p>}</section></BaseLayout>

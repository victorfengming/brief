---
import { LOCALES } from '../../i18n.js';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const { locale } = Astro.params as { locale: 'zh' | 'en' };
const zh = locale === 'zh';
const text = zh ? { title: '关于我', description: '关于自动驾驶云端工程方向、技能与职业经历。', lead: `${site.description} 这里的个人经历尚未填入，避免把示例内容误认为真实履历。`, approach: '工程实践与持续学习', approachBody: '[在此填写真实的工作背景、技术方向和你希望解决的问题。] 这个站点将项目实践、技术文章和可复现实验放在一起，方便读者沿着问题、方案和验证方法了解工作方式。', experience: '工作经历', placeholder: '[职位名称] / [公司或组织]', experienceBody: '[填写职责、具体贡献和可公开的成果。]', toolbox: '技能与方向', note: '技能标签来自方案草稿，请根据实际经验调整。', education: '教育背景', educationBody: '[学校 / 专业 / 学位 / 时间]' } : { title: 'About me', description: 'My focus on autonomous-driving cloud engineering, skills, and professional experience.', lead: 'I focus on autonomous-driving cloud systems, distributed communication, and reliable engineering practice. Personal experience is intentionally left blank so example content is not mistaken for a real resume.', approach: 'Engineering practice and continuous learning', approachBody: '[Add your real background, technical focus, and the problems you want to solve here.] This site brings project work, technical writing, and reproducible experiments together so readers can follow the problem, approach, and validation method.', experience: 'Experience', placeholder: '[Role] / [Company or organization]', experienceBody: '[Add responsibilities, specific contributions, and publishable outcomes.]', toolbox: 'Skills and focus', note: 'These skills come from a draft plan; adjust them to match actual experience.', education: 'Education', educationBody: '[School / major / degree / dates]' };
---
<BaseLayout {locale} title={text.title} description={text.description} route="about"><div class="container page-hero"><p class="eyebrow">ABOUT / PROFILE</p><h1>{text.title}<span class="gradient-text">.</span></h1><p class="lead">{text.lead}</p></div><section class="container section two-col"><div><p class="eyebrow">01 / APPROACH</p><h2>{text.approach}</h2></div><div class="prose"><p>{text.approachBody}</p></div></section><section class="container section two-col lined"><div><p class="eyebrow">02 / EXPERIENCE</p><h2>{text.experience}</h2></div><div class="experience">{[0, 1].map(() => <div><span>[20XX — {zh ? '至今' : 'Present'}]</span><h3>{text.placeholder}</h3><p>{text.experienceBody}</p></div>)}</div></section><section class="container section two-col lined"><div><p class="eyebrow">03 / TOOLBOX</p><h2>{text.toolbox}</h2></div><div><div class="tag-row">{site.skills.map((skill) => <span class="tag">{skill}</span>)}</div><p class="muted skills-note">{text.note}</p><h3>{text.education}</h3><p class="muted">{text.educationBody}</p></div></section></BaseLayout>
<style>.two-col{display:grid;grid-template-columns:38% 1fr;gap:50px}.lined{border-top:1px solid var(--line)}.experience>div{padding:0 0 30px;margin-bottom:30px;border-bottom:1px solid var(--line)}.experience span{color:var(--cyan);font:12px ui-monospace,monospace}.experience h3{margin:15px 0 10px}.experience p,.skills-note{color:var(--muted);line-height:1.8}.skills-note{margin:24px 0 50px}@media(max-width:700px){.two-col{grid-template-columns:1fr;gap:15px}}</style>

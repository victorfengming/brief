---
import type { CollectionEntry } from 'astro:content';
import { path } from '../config/site';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
---
<article class="card">
  <div class="card-kicker">CASE STUDY / {String(project.data.order).padStart(2, '0')}</div>
  <h3>{project.data.title}</h3>
  <p>{project.data.summary}</p>
  <div class="tag-row">{project.data.techStack.map((tag) => <span class="tag">{tag}</span>)}</div>
  <a class="card-link" href={path(`projects/${project.id}/`)} aria-label={`阅读项目：${project.data.title}`}>阅读案例 ↗</a>
</article>

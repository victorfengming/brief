---
import { path } from '../config/site';
import { copy, counterpartPath, localizedPath } from '../i18n.js';
type Locale = 'zh' | 'en';
interface Props { locale: Locale; route?: string; contentType?: 'blog' | 'projects'; contentId?: string; translatedIds?: Set<string>; }
const { locale, route = '', contentType, contentId, translatedIds = new Set<string>() } = Astro.props;
const strings = copy(locale);
const targetLocale = locale === 'zh' ? 'en' : 'zh';
const alternatePath = contentType && contentId
  ? counterpartPath(targetLocale, contentType, contentId, translatedIds)
  : localizedPath(targetLocale, route);
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={path(localizedPath(locale))} aria-label={strings.homeLabel}><span>&lt;</span> AUTONOMOUS / CLOUD <span>/&gt;</span></a>
    <button class="menu-toggle" type="button" aria-label={strings.openMenu} aria-expanded="false" aria-controls="primary-nav">{strings.menu} ☰</button>
    <nav class="nav" id="primary-nav" aria-label={strings.primaryNavigation}>
      {strings.navigation.map(([label, itemRoute]: [string, string]) => <a href={path(localizedPath(locale, itemRoute))} aria-current={current === path(localizedPath(locale, itemRoute)) ? 'page' : undefined}>{label}</a>)}
      <a class="language-switch" href={path(alternatePath)} data-locale={targetLocale} aria-label={`Switch language to ${targetLocale === 'en' ? 'English' : 'Chinese'}`}>中文 / EN</a>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
    nav?.setAttribute('data-open', String(open));
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    button?.setAttribute('aria-expanded', 'false');
    nav?.setAttribute('data-open', 'false');
  }));
  document.querySelectorAll<HTMLAnchorElement>('.language-switch').forEach((link) => link.addEventListener('click', () => {
    try { localStorage.setItem('portfolio-locale', link.dataset.locale ?? 'zh'); } catch {}
  }));
</script>

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { site, path } from '../config/site';

interface Props { title?: string; description?: string; image?: string; }
const { title, description = site.description, image } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : `${site.title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = image ? new URL(image.replace(/^\//, ''), Astro.site ?? Astro.url).toString() : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080d16" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={path('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">跳转到正文</a>
    <Header />
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} {site.name} · Built with Astro</span>
        <span><a href={path('projects/')}>Projects</a> · <a href={path('blog/')}>Writing</a> · <a href={path('contact/')}>Contact</a></span>
      </div>
    </footer>
  </body>
</html>

{
  "name": "autonomous-engineer-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:status": "astro dev status",
    "dev:stop": "astro dev stop",
    "dev:restart": "astro dev --force",
    "build": "npm run diagram:check && npm run pdf:check && astro build",
    "test": "node --test",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "diagram:check": "node scripts/check-article-diagrams.mjs",
    "diagram:generate": "node scripts/generate-article-diagrams.mjs",
    "pdf:check": "node scripts/check-article-pdfs.mjs",
    "pdf:generate": "node scripts/generate-article-pdfs.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-xml-parser": "5.4.1",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3"
  }
}
